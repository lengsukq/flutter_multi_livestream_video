{
  "name": "chime-demo-server",
  "version": "0.1.0",
  "private": true,
  "description": "Reference provider-adapter media backend for Chime, LiveKit, Agora, TRTC, and future RTC providers.",
  "type": "module",
  "main": "server.ts",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server.ts",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@alicloud/live20161101": "^3.0.2",
    "@alicloud/openapi-client": "^0.4.15",
    "@alicloud/rtc20180111": "^4.3.5",
    "@alicloud/vod20170321": "^3.12.1",
    "@aws-sdk/client-chime-sdk-media-pipelines": "^3.1149.0",
    "@aws-sdk/client-chime-sdk-meetings": "^3.600.0",
    "@aws-sdk/client-ivs-realtime": "^3.1149.0",
    "@aws-sdk/client-ivschat": "^3.1141.0",
    "@aws-sdk/client-mediaconvert": "^3.1149.0",
    "@aws-sdk/client-s3": "^3.1149.0",
    "@types/ali-oss": "^6.23.3",
    "agora-token": "^2.0.6",
    "ali-oss": "^6.23.0",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "tls-sig-api-v2": "^1.0.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/node": "^26.6.2",
    "typescript": "^7.0.2"
  }
}
