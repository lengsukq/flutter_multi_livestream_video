# Uncomment this line to define a global platform for your project
platform :ios, '15.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!
  use_modular_headers!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

# Agora RTC is resolved through SwiftPM while Agora Chat currently comes
# through CocoaPods. Both carry the same dynamic aosl.framework. Agora RTC's
# AgoraInfra 1.3.5 is within Chat's ~> 1.3.0 compatibility range, so the app
# keeps the SwiftPM runtime and removes only CocoaPods' duplicate Runner embed.
def remove_duplicate_agora_aosl_embed
  support_dir = File.join(__dir__, 'Pods', 'Target Support Files', 'Pods-Runner')
  return unless Dir.exist?(support_dir)

  frameworks_script = File.join(support_dir, 'Pods-Runner-frameworks.sh')
  if File.exist?(frameworks_script)
    content = File.readlines(frameworks_script).reject do |line|
      line.include?('ShengwangInfra_iOS/aosl.framework')
    end.join
    File.write(frameworks_script, content)
  end

  Dir.glob(File.join(support_dir, 'Pods-Runner-frameworks-*-input-files.xcfilelist')).each do |path|
    content = File.readlines(path).reject do |line|
      line.include?('ShengwangInfra_iOS/aosl.framework/aosl')
    end.join
    File.write(path, content)
  end

  Dir.glob(File.join(support_dir, 'Pods-Runner-frameworks-*-output-files.xcfilelist')).each do |path|
    content = File.readlines(path).reject do |line|
      line.include?('${TARGET_BUILD_DIR}/${FRAMEWORKS_FOLDER_PATH}/aosl.framework')
    end.join
    File.write(path, content)
  end
end

post_integrate do |_installer|
  remove_duplicate_agora_aosl_embed
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    target.build_configurations.each do |config|
      config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] ||= [
        '$(inherited)',
        'PERMISSION_CAMERA=1',
        'PERMISSION_MICROPHONE=1',
      ]
    end
  end
end
