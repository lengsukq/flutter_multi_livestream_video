{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Flutter macOS Debug (CocoaPods + Hot Reload)",
      "type": "shell",
      "command": "${workspaceFolder}/run_macos_debug.command",
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": { "reveal": "always", "focus": true, "panel": "dedicated" },
      "problemMatcher": []
    },
    {
      "label": "Regenerate bundled provider Web SDK assets",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/build_provider_web_assets.sh",
      "problemMatcher": []
    }
  ]
}
